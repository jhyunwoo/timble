datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String        @unique
  emailVerified  DateTime?
  image          String?
  createdAt      DateTime      @default(now())
  role           role          @default(USER)
  admin          String?
  school         school?       @relation(fields: [schoolId], references: [id])
  schoolId       Int?
  studentgroup   studentgroup? @relation(fields: [studentgroupId], references: [id])
  studentgroupId String?
  diploma        diploma?      @relation(fields: [diplomaId], references: [id])
  diplomaId      String?
  timetable      timetable[]
  accounts       Account[]
  sessions       Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model timetable {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  name     String
  semester String
  periods  period[]
}

model period {
  id          String    @id @default(cuid())
  timetable   timetable @relation(fields: [timetableId], references: [id])
  timetableId String
  period      Int
  subject     subject   @relation(fields: [subjectId], references: [id])
  subjectId   String
}

model school {
  id           Int            @id @default(autoincrement())
  code         String         @unique
  name         String
  types        subjectType[]
  areas        subjectArea[]
  difficulties difficulty[]
  groups       studentgroup[]
  subjects     subject[]
  diplomas     diploma[]
  students     User[]
}

model studentgroup {
  id                String              @id @default(cuid())
  school            school              @relation(fields: [schoolId], references: [id])
  schoolId          Int
  name              String
  entrance          Int
  students          User[]
  subjects          subject[]
  essentialsubjects essentialsubjects[]
}

model essentialsubjects {
  id             String       @id @default(cuid())
  group          studentgroup @relation(fields: [studentgroupId], references: [id])
  studentgroupId String
  year           Int
  semester       Int
  subjects       subject[]
}

model subject {
  id                   String             @id @default(cuid())
  school               school?            @relation(fields: [schoolId], references: [id])
  schoolId             Int?
  diplomas             diploma[]
  title                String
  open                 String[]
  prerequisite         subject[]          @relation("SubjectPrerequisite")
  prerequisiteRelation subject[]          @relation("SubjectPrerequisite")
  difficulty           difficulty?        @relation(fields: [difficultyId], references: [id])
  difficultyId         String?
  area                 subjectArea?       @relation(fields: [areaId], references: [id])
  areaId               String?
  type                 subjectType?       @relation(fields: [typeId], references: [id])
  typeId               String?
  target               String
  relatedMajor         String
  targetParticipants   String
  CSATSubject          Boolean
  contents             subjectcontent[]
  periods              period[]
  studentgroup         studentgroup?      @relation(fields: [studentgroupId], references: [id])
  studentgroupId       String?
  essentialsubjects    essentialsubjects? @relation(fields: [essentialsubjectsId], references: [id])
  essentialsubjectsId  String?
}

model subjectcontent {
  id         String   @id @default(cuid())
  subject    subject? @relation(fields: [subjectId], references: [id])
  subjectId  String?
  order      Int
  area       String
  mainTarget String[]
  detail     String
}

model diploma {
  id          String    @id @default(cuid())
  name        String
  description String?
  subjects    subject[]
  school      school?   @relation(fields: [schoolId], references: [id])
  schoolId    Int?
  students    User[]
}

model subjectType {
  id       String    @id @default(cuid())
  name     String
  subject  subject[]
  school   school    @relation(fields: [schoolId], references: [id])
  schoolId Int
}

model subjectArea {
  id       String    @id @default(cuid())
  school   school    @relation(fields: [schoolId], references: [id])
  schoolId Int
  name     String
  subject  subject[]
}

model difficulty {
  id       String    @id @default(cuid())
  school   school    @relation(fields: [schoolId], references: [id])
  schoolId Int
  subject  subject[]
  name     String
}

enum role {
  USER
  ADMIN
  SUPERADMIN
}
