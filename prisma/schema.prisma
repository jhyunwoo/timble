datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String      @unique
  emailVerified DateTime?
  image         String?
  School        school?     @relation(fields: [schoolId], references: [id])
  schoolId      Int?
  year          Int?
  diploma       diploma?    @relation(fields: [diplomaId], references: [id])
  diplomaId     String?
  admin         String?
  createdAt     DateTime    @default(now())
  role          role        @default(USER)
  accounts      Account[]
  sessions      Session[]
  Timetable     Timetable[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Timetable {
  id     String  @id @default(cuid())
  year   Int?
  semi   Int?
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  class1 String?
  class2 String?
  class3 String?
  class4 String?
  class5 String?
  class6 String?
}

model school {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  name        String
  color       String?
  subjects    Subject[]
  students    User[]
  diplomas    diploma[]
  subjectType subjectType[]
  subjectArea subjectArea[]
  difficulty  difficulty[]
}

model Subject {
  id                   Int              @id @default(autoincrement())
  School               school?          @relation(fields: [schoolId], references: [id])
  schoolId             Int?
  diplomas             diploma[]
  title                String
  open                 String[]
  prerequisite         Subject[]        @relation("SubjectPrerequisite")
  prerequisiteRelation Subject[]        @relation("SubjectPrerequisite")
  type                 subjectType      @relation(fields: [subjectTypeId], references: [id])
  subjectTypeId        String
  target               String
  relatedMajor         String
  content              subjectcontent[]
  subjectArea          subjectArea      @relation(fields: [subjectAreaId], references: [id])
  subjectAreaId        String
  targetParticipants   String
  CSATSubject          Boolean
  difficulty           difficulty       @relation(fields: [difficultyId], references: [id])
  difficultyId         String
}

model subjectcontent {
  id         String   @id @default(cuid())
  subject    Subject? @relation(fields: [subjectId], references: [id])
  subjectId  Int?
  order      Int
  area       String
  mainTarget String[]
  detail     String
}

model diploma {
  id          String    @id @default(cuid())
  name        String
  description String?
  subjects    Subject[]
  school      school?   @relation(fields: [schoolId], references: [id])
  schoolId    Int?
  students    User[]
}

model subjectType {
  id       String    @id @default(cuid())
  name     String
  school   school    @relation(fields: [schoolId], references: [id])
  Subject  Subject[]
  schoolId Int
}

model subjectArea {
  id       String    @id @default(cuid())
  school   school    @relation(fields: [schoolId], references: [id])
  schoolId Int
  Subject  Subject[]
  name     String
}

model difficulty {
  id       String    @id @default(cuid())
  school   school    @relation(fields: [schoolId], references: [id])
  schoolId Int
  Subject  Subject[]
  name     String
}

enum role {
  USER
  ADMIN
}
